# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/

# stray files not part of the app (unrelated script w/ a live API token; unused root assets)
/test.js
/logo.png
/contact us.webp

# runtime-uploaded admin images: seed files are committed once, but new
# uploads made on the server must stay local and never be touched by git
public/images/products/*
public/images/categories/*
public/images/posts/*
!public/images/products/.gitkeep
!public/images/categories/.gitkeep
!public/images/posts/.gitkeep
